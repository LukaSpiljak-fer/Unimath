# SMTP postavke (na cPanelu: kreiraj email račun, npr. no-reply@unimath.hr,
# host je obično mail.unimath.hr, port 465 uz SMTP_SECURE=true)
SMTP_HOST=mail.unimath.hr
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=no-reply@unimath.hr
SMTP_PASS=

# Pošiljatelj i primatelj
SENDER_EMAIL=no-reply@unimath.hr
TO_EMAIL=info@unimath.hr
EMAIL_SUBJECT=Upit s web stranice

# Dozvoljeni origini za CORS (zarezom odvojeni)
ALLOWED_ORIGINS=https://unimath.hr,https://www.unimath.hr

# Port za lokalni razvoj (na cPanelu ga postavlja Passenger)
PORT=8000
